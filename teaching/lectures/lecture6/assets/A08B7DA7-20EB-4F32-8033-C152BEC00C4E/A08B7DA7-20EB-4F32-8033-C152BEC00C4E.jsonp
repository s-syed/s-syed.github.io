ation":0.001,"type":"transition","attributes":{"direction":0},"name":"none","objectID":"0"}],"automaticPlay":false,"hyperlinks":[],"accessibility":[{"text":"The linear path greedily matches densities point wise for each ￼","targetRectangle":{"y":331.71267700195312,"x":62.764708280563354,"width":596.94565874241323,"height":28.000000339140627}},{"text":"We will see later how to design better paths","targetRectangle":{"y":431.52410888671875,"x":97.764708280563354,"width":412.38999999999999,"height":26.361846923828125}},{"text":"e.g. probability, Bayesian, information geomerty, optimisation, and statistical mechanics","targetRectangle":{"y":277.5460205078125,"x":97.764708280563354,"width":821.91999999999996,"height":26.361846923828125}},{"text":"equation.pdf","targetRectangle":{"y":181.10425186157227,"x":452.89260864257812,"width":118.21476414750077,"height":31.173250119209285}},{"text":"Linear path","targetRectangle":{"y":56.908382415771484,"x":36,"width":186.57600000000002,"height":48.400146484375}},{"text":"￼","targetRectangle":{"y":66.408382415771484,"x":976.09613084793091,"width":11.51953125,"height":28}},{"text":"It is rarely optimal for sampling, but is practical","targetRectangle":{"y":380.45889282226562,"x":97.764708280563354,"width":436.39199999999983,"height":26.361846923828125}},{"text":"This object is independent of the state-space ￼, making it very generally applicable","targetRectangle":{"y":129.53212738037109,"x":62.764708280563354,"width":784.72584214903952,"height":28.000000339140627}},{"text":"It has been independently been discovered and applied in a variety of domains","targetRectangle":{"y":231.9012451171875,"x":97.764708280563354,"width":740.4319999999999,"height":26.361846923828125}},{"text":"equation.pdf","targetRectangle":{"y":331.71267700195312,"x":649.17470828056321,"width":10.535658742413375,"height":28.000000339140627}},{"text":"equation.pdf","targetRectangle":{"y":129.53212738037109,"x":495.0867082805633,"width":18.223842149039285,"height"